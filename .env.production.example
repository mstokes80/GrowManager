# ============================================================
# GrowManager Production Environment Variables
# ============================================================
# Copy this file to .env.production and fill in actual values
# IMPORTANT: Never commit .env.production to version control
# ============================================================

# -------------------------
# Application Configuration
# -------------------------
SPRING_PROFILES_ACTIVE=prod

# -------------------------
# Frontend Configuration
# -------------------------
FRONTEND_PORT=80
FRONTEND_URL=https://growmanager.com

# -------------------------
# Backend Configuration
# -------------------------
BACKEND_PORT=8080

# -------------------------
# Database Configuration
# -------------------------
# REQUIRED: Set a strong password
DB_NAME=growmanager
DB_USERNAME=growmanager
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_PORT=5432

# -------------------------
# Redis Configuration
# -------------------------
# REQUIRED: Set a strong password for production
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# -------------------------
# MinIO/S3 Configuration
# -------------------------
# REQUIRED: Set strong credentials
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_SECRET_KEY_MINIMUM_8_CHARS
MINIO_BUCKET_NAME=growmanager
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BROWSER=on

# -------------------------
# JWT Configuration
# -------------------------
# REQUIRED: Generate a secure random string (256+ bits)
# Use: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_RANDOM_STRING_256_BITS_OR_MORE
JWT_ACCESS_EXPIRATION=900000        # 15 minutes in milliseconds
JWT_REFRESH_EXPIRATION=604800000    # 7 days in milliseconds

# -------------------------
# Email Configuration
# -------------------------
# REQUIRED: Configure SMTP for production email service
# Examples: Gmail, SendGrid, AWS SES, Mailgun
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_FROM=noreply@growmanager.com

# -------------------------
# CORS Configuration
# -------------------------
# Set to your production domain(s), comma-separated
CORS_ALLOWED_ORIGINS=https://growmanager.com,https://www.growmanager.com

# -------------------------
# JVM Options (Optional)
# -------------------------
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

# ============================================================
# SECURITY CHECKLIST BEFORE DEPLOYMENT
# ============================================================
# [ ] Changed all passwords from defaults
# [ ] Generated secure JWT_SECRET (256+ bits)
# [ ] Configured production email service
# [ ] Updated FRONTEND_URL to production domain
# [ ] Updated CORS_ALLOWED_ORIGINS to production domain(s)
# [ ] Database password is strong (16+ characters)
# [ ] Redis password is strong (16+ characters)
# [ ] MinIO credentials are strong
# [ ] SSL/TLS certificate obtained and configured
# [ ] Firewall configured (ports 80, 443, 22 only)
# [ ] Backups configured for database and MinIO
# ============================================================