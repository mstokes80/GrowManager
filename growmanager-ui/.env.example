# API Configuration
# IMPORTANT: Leave empty in development to use Vite's proxy (configured in vite.config.ts)
# In production, set to your domain (e.g., https://yourdomain.com) or leave empty for relative URLs
# VITE_API_URL=

# MinIO Configuration (for direct uploads if needed)
VITE_MINIO_ENDPOINT=http://localhost:9000

# App Configuration
VITE_APP_NAME=GrowManager
VITE_APP_VERSION=1.0.0